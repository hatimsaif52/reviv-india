}),{rootMargin:'200px'});
function vid(src){const v=document.createElement('video');v.dataset.src=src;v.muted=true;v.loop=true;v.playsInline=true;v.preload='none';v.setAttribute('aria-hidden','true');vio.observe(v);return v;}

