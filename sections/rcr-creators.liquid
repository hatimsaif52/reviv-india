lid var(--line);color:var(--text);cursor:pointer;transition:background-color .3s var(--ease)}#rcr .iconbtn:hover{background:var(--s3)}#rcr .player .hint{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);padding:4px 12px;border-radius:9999px;background:rgba(24,24,24,.8)}#rcr{position:relative;overflow-x:hidden;font-family:Manrope,system-ui,sans-serif}#rcr h1,#rcr h2,#rcr h3,#rcr p,#rcr summary{color:inherit;font-family:inherit;text-transform:none}#rcr .hero{padding-top:64px}#rcr .player{z-index:2147483000}
