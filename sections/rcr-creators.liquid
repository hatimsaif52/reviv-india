}),{root:feed,threshold:[0,.6]});
let lastFocus=null;
function openPlayer(c){
  lastFocus=document.activeElement;
  feed.innerHTML='';
  c.clips.forEach(src=>{
    const s=document.createElement('div');s.className='slide';
    const v=document.createElement('video');v.dataset.src=src;v.playsInline=true;v.loop=true;v.controls=true;v.preload='none';
    s.appendChild(v);feed.appendChild(s);pio.observe(v);
  });
  document.getElementById('who').textContent=c.name+(c.handle?'  '+c.handle:'')+'  \u00b7  '+c.clips.length+' videos';
  document.getElementById('hint').style.display=c.clips.length>1?'block':'none';
  player.classList.add('open');document.body.style.overflow='hidden';feed.scrollTop=0;
  document.getElementById('close').focus();
}
function closePlayer(){
  feed.querySelectorAll('video').forEach(v=>{v.pause();pio.unobserve(v);});
  player.classList.remove('open');document.body.style.overflow='';feed.innerHTML='';
  if(lastFocus) lastFocus.focus();
}
document.getElementById('close').onclick=closePlayer;
addEventListener('keydown',e=>{if(e.key==='Escape'&&player.classList.contains('open'))closePlayer();});

// section reveals
const rio=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');rio.unobserve(e.target);}}),{threshold:.15});
