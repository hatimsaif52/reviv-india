    <button class="iconbtn" id="close" aria-label="Close videos"><svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M205.7 194.3a8 8 0 0 1-11.4 11.4L128 139.3l-66.3 66.4a8 8 0 0 1-11.4-11.4l66.4-66.3-66.4-66.3a8 8 0 0 1 11.4-11.4l66.3 66.4 66.3-66.4a8 8 0 0 1 11.4 11.4L139.3 128Z"/></svg></button>
  </div>
  <div class="hint caption-5 muted" id="hint">Scroll for more</div>
</div>
