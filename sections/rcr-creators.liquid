// tagline word reveal
const tag=document.getElementById('tagline');
const gold=new Set(['earning','money']);
tag.innerHTML=tag.textContent.split(' ').map(w=>'<span class="w'+(gold.has(w.replace(/[^a-z]/gi,'').toLowerCase())?' g':'')+'">'+w+'</span>').join(' ');
const words=[...tag.querySelectorAll('.w')];
if(matchMedia('(prefers-reduced-motion: reduce)').matches){words.forEach(w=>w.classList.add('on'));}
else{
  let ticking=false;
  const upd=()=>{const line=innerHeight*0.62;words.forEach(w=>w.classList.toggle('on',w.getBoundingClientRect().top<line));ticking=false;};
  addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(upd);}},{passive:true});upd();
}

