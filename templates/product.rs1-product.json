      "settings": {
        "adv_eyebrow": "— THE RS1 ADVANTAGE —",
        "adv_title": "The Mouthguard Built <em>Different</em>",
        "problem_eyebrow": "THE PROBLEM",
        "problem_title": "Your jaw is throwing off everything below it — and it's costing you <em>performance</em>.",
        "problem_body": "<p>When your jaw sits out of position, your whole skeleton compensates for it. You lose the symmetry your body relies on to move efficiently, you burn energy clenching instead of competing, and you hit a ceiling that no amount of training or supplements will break through.</p>",
        "problem_image": "shopify://shop_images/the-problem.jpg",
        "solution_eyebrow": "THE SOLUTION",
        "solution_title": "One simple spacing shift <em>unlocks everything.</em>",
        "solution_body": "<p>The RS1 creates spacing between your upper and lower jaw, helping promote a more relaxed jaw position and natural oral posture. This subtle shift can support better breathing, improved comfort, and more efficient movement. So you can perform, recover, and feel your best from the very first use.</p>",
        "works_eyebrow": "HOW TO USE IT",
        "works_title": "How to use your <em>RS1</em>",
        "works_body": "<p>Four mechanisms working together — measured at the jaw, felt through the whole kinetic chain.</p>",
        "works_video_url": "",
        "who_eyebrow": "WHO IT'S FOR",
        "who_title": "Already a Reviv user? RS1 is what you <em>wear when you move.</em>",
        "who_image": "shopify://shop_images/who-its-for.jpg"
      }
    },
