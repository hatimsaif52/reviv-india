        "problem_item_1": {
          "type": "problem_item",
          "settings": {
            "number": "01",
            "text": "Clenching under pressure burns energy you need late in the game"
          }
        },
        "problem_item_2": {
          "type": "problem_item",
          "settings": {
            "number": "02",
            "text": "A misaligned jaw wrecks the symmetry your whole body depends on to move well"
          }
        },
        "problem_item_3": {
          "type": "problem_item",
          "settings": {
            "number": "03",
            "text": "A restricted airway means less oxygen exactly when you need it most"
          }
        },
        "problem_item_4": {
          "type": "problem_item",
          "settings": {
            "number": "04",
            "text": "Grinding wears down your teeth and speeds up the fatigue that follows"
          }
        },
        "solution_item_1": {
          "type": "solution_item",
          "settings": {
            "icon": "shopify://shop_images/Frame_14434_9.png",
            "title": "Unlocking the bite",
            "text": "We like to say... \"for the skeleton to change, the bite needs to be able to change.\"  Which is why we believe it is important that you unlock how the upper and lower teeth come together when exercising."
          }
        },
        "solution_item_2": {
          "type": "solution_item",
          "settings": {
            "icon": "shopify://shop_images/Frame_14434_7.png",
            "title": "Adding vertical height",
            "text": "Add height between the teeth creates a biomechanical 'stretch' on the rest of the body in our experience.  And that works in your favor in terms of not getting fatigued or sore as easily."
          }
        },
        "solution_item_3": {
          "type": "solution_item",
          "settings": {
            "icon": "shopify://shop_images/Frame_14434_11.png",
            "title": "Remodel the skeleton",
            "text": "What if you could use every athletic session to remodel the skeleton positively so that you are stronger and more flexible over time?  That is the power of leveraging biomechanics in our view."
          }
        },
        "works_item_1": {
          "type": "works_item",
          "settings": {
            "number": "01",
            "icon": "shopify://shop_images/Frame_14434.png",
            "title": "Do not mold",
            "text": "Just wash it off after you receive it."
          }
        },
        "works_item_2": {
          "type": "works_item",
          "settings": {
            "number": "02",
            "icon": "shopify://shop_images/Frame_14434_2.png",
            "title": "Pop it in your mouth",
            "text": "The ledges should face down and sit inside the lower teeth. This helps keep it in place."
          }
        },
        "works_item_3": {
          "type": "works_item",
          "settings": {
            "number": "03",
            "icon": "shopify://shop_images/Frame_14434_3.png",
            "title": "Use it while playing athletics",
            "text": "Clench lightly on it while active. Take it out when speaking."
          }
        },
        "works_item_4": {
          "type": "works_item",
          "settings": {
            "number": "04",
            "icon": "shopify://shop_images/Frame_14434_4.png",
            "title": "Wash it after use",
            "text": "Wash with warm water and soap.  Leave to dry in a dry place."
          }
        },
        "who_item_1": {
          "type": "who_item",
          "settings": {
            "title": "At the gym",
            "text": "Wear it through your workout the same way you wear RS1 at night. Keep the jaw spacing going around the clock."
          }
        },
        "who_item_2": {
          "type": "who_item",
          "settings": {
            "title": "In a class or group session",
            "text": "Yoga, spin, HIIT—whatever moves you. RS1 fits discreetly and stays out of your way."
          }
        },
        "who_item_3": {
          "type": "who_item",
          "settings": {
            "title": "Playing a sport",
            "text": "Tennis, golf, basketball, pickleball. Any activity where you'll benefit from jaw spacing and tooth protection."
          }
        },
        "who_item_4": {
          "type": "who_item",
          "settings": {
            "title": "Just active in daily life",
            "text": "Gardening, hiking, cycling—if you're moving, RS1 extends the benefits of your Reviv routine into your waking hours."
          }
        }
